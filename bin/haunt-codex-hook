#!/bin/bash
# Forwards Codex CLI hook events (and the legacy `notify` payload) to haunt as v1 events with agent "codex".
# Usage: haunt-codex-hook               (hook JSON on stdin; dispatches on hook_event_name)
#        haunt-codex-hook notify <json> (Codex `notify` program; payload is the last argv)

# Outside haunt nobody parses these, and hooks run inline with the agent, so bail out first.
[ "$HAUNT" = 1 ] || exit 0

VERSION="0.1.0"
if [ "${1:-}" = notify ]; then
    KIND=notify
    INPUT="${2:-}"
else
    INPUT=$(cat)
    KIND=$(printf '%s' "$INPUT" | jq -r '.hook_event_name // empty | strings' 2>/dev/null)
fi
# Ghostty cuts a notification body at 255 bytes; past that it arrives as broken JSON.
OSC_MAX=250
# The socket takes 64 KB lines; the margin covers the newline. Tests may lower it.
SOCK_MAX="${HAUNT_HOOK_SOCK_MAX:-60000}"
SOCK="${HAUNT_SOCK:-}"
TTY="${HAUNT_HOOK_TTY:-/dev/tty}"

LIB='
def env($k): ($ENV[$k] // "") | if . == "" then null else . end;
def nonce: env("HAUNT_HOOK_NONCE");
def sid: if $sock then env("HAUNT_SURFACE_ID") else null end;
def base($e): {v:1, agent:"codex", event:$e, surface_id:sid, session_id, cwd, agent_id, agent_type, permission_mode, nonce:nonce};
def ti: .tool_input | if type == "object" then . else {} end;
def abs($p): if ($p | startswith("/")) or (.cwd | type) != "string" then $p else (.cwd | rtrimstr("/")) + "/" + $p end;
# apply_patch sends the whole patch as `command`; haunt only needs the files it touches, in patch order.
def patch_paths: . as $r | [ti.command | strings | split("\n")[] | rtrimstr("\r") | capture("^\\*\\*\\* (?:(?:Add|Update|Delete) File|Move to): (?<p>.+)$").p]
  | map(. as $p | $r | abs($p)) | reduce .[] as $p ([]; if any(.[]; . == $p) then . else . + [$p] end);
# Every path, one per line: a patch must never pass for a one-file edit, and the newline keeps haunt from answering it.
def preview:
  if .tool_name == "apply_patch" then patch_paths | if length == 0 then {} else {file_path:join("\n")} end
  else (.tool_input // {}) | if type == "object" then {command, url, file_path} | map_values(strings) | with_entries(select(.value != null)) else {} end
  end;
def tool: {tool_name, tool_use_id, tool_input:preview};
# Unicode Cf (format) characters, such as bidi overrides and zero-widths, which can disguise text.
def isfmt: . == 173 or (. >= 1536 and . <= 1541) or . == 1564 or . == 1757 or . == 1807 or (. >= 2192 and . <= 2193) or . == 2274
  or . == 6158 or (. >= 8203 and . <= 8207) or (. >= 8234 and . <= 8238) or (. >= 8288 and . <= 8292) or (. >= 8294 and . <= 8303)
  or . == 65279 or (. >= 65529 and . <= 65531) or . == 69821 or . == 69837 or (. >= 78896 and . <= 78911)
  or (. >= 113824 and . <= 113827) or (. >= 119155 and . <= 119162) or . == 917505 or (. >= 917536 and . <= 917631);
def clean: if type == "string" then explode | map(select(. >= 32 and (. < 127 or . > 159) and (isfmt | not))) | implode else . end;
def bytes: tojson | utf8bytelength;
def shrink($p):
  if bytes <= $max then .
  else (getpath($p) | if type == "string" then rtrimstr("…") else . end) as $s
  | if ($s | type) != "string" or ($s | length) == 0 then .
    else ($s | tojson | utf8bytelength) as $sb
    | ([($s | length) - ((bytes - $max + 3) * ($s | length) / $sb | ceil), 0] | max) as $keep
    | setpath($p; $s[:$keep] + "…") | .truncated = true
    | if $keep == 0 then . else shrink($p) end
    end
  end;
def fit:
  reduce (["tool_input","command"], ["tool_input","url"], ["tool_input","file_path"], ["summary"], ["query"],
          ["message"], ["description"], ["task_subject"], ["cwd"]) as $p (.; shrink($p))
  | if bytes <= $max then .
    else {v, agent, event, surface_id, session_id, agent_id, tool_use_id, task_id, tool_name, nonce}
      | with_entries(select(.value != null)) + {truncated:true}
    end
  # An event whose ids alone overflow cannot be delivered intact, so it is dropped.
  | select(bytes <= $max);
# tool_input goes over the socket unmodified (JSON escapes keep it on one line), so the core can show a
# hidden newline or bidi override instead of an approval preview that looks harmless.
def finalize: with_entries(select(.value != null)) | .tool_input as $ti | del(.tool_input) | walk(clean)
  | (if $ti == null then . else . + {tool_input:$ti} end) | fit;
# OSC is status-only in the core, so it carries no nonce: just what moves status and progress, plus a cut title.
def status:
  with_entries(select(.value != null)) | walk(clean)
  | {v, agent, event, agent_id, agent_type, task_id, task_status, task_subject, description, tool_name, tool_count, todos_done, notification_type}
  | with_entries(select(.value != null))
  | shrink(["task_subject"]) | shrink(["description"])
  | if bytes <= $max then . else del(.agent_type) end
  | select(bytes <= $max);
'

case "$KIND" in
    SessionStart)
        EXPR='base("session_start") + {model:((.model | strings) // null), source, plugin_version:$version}'
        ;;
    UserPromptSubmit)
        # A subagent's prompt is its parent's message to it; it must not replace the row's prompt or reset progress.
        EXPR='select(.agent_id == null) | base("prompt_submit") + {query:.prompt}'
        ;;
    PreToolUse)
        EXPR='(base("tool_start") + tool),
              # Codex reports the default role as "default" on SubagentStart, so the spawn must match it.
              (if .tool_name == "spawn_agent" then base("subagent_spawn") + {agent_type:((ti.agent_type | strings) // "default"),
                  description:([ti.task_name, (ti.message | strings | split("\n")[0][:80])] | map(strings | select(. != "")) | first)} else empty end),
              (if .tool_name == "request_user_input" then base("question_asked") else empty end)'
        ;;
    PostToolUse)
        EXPR='(if .tool_name == "update_plan" then base("todos_written") + {tool_count:([ti.plan | arrays[]] | length), todos_done:([ti.plan | arrays[] | select(.status? == "completed")] | length)} else empty end),
              (if .tool_name == "apply_patch" then (patch_paths[:20][] as $f | base("file_edited") + {tool_name, tool_input:{file_path:$f}}) else empty end),
              (base("tool_done") + tool),
              # Exact input, so a pending permission prompt resolves only against the call that ran.
              (base("tool_ran") + {tool_name, tool_use_id, tool_input:(preview | del(.url))}),
              (if .agent_id then base("subagent_tool") + {tool_name} else empty end)'
        ;;
    PermissionRequest)
        EXPR='base("permission_seen") + {tool_name, tool_input:(preview | del(.url))}'
        ;;
    SubagentStart)
        EXPR='base("subagent_start")'
        ;;
    SubagentStop)
        EXPR='base("subagent_stop")'
        ;;
    # Interrupt (newer Codex) ends the turn without a Stop.
    Stop|Interrupt)
        EXPR='base("stop")'
        ;;
    notify)
        EXPR='select(.type == "agent-turn-complete") | {session_id:."thread-id", cwd} | base("stop")'
        ;;
    *)
        exit 0
        ;;
esac

# bodies <max bytes> <true for the socket>
bodies() {
    printf '%s' "$INPUT" | jq -c --argjson max "$1" --argjson sock "$2" --arg version "$VERSION" \
        "$LIB ($EXPR) | if \$sock then finalize else status end" 2>/dev/null
}

# The socket is the authenticated path. If it is there, a failed send (no nc included) is dropped rather than downgraded to OSC.
if [ -n "$SOCK" ] && [ -S "$SOCK" ] && [ -n "${HAUNT_SURFACE_ID:-}" ]; then
    command -v nc > /dev/null || exit 0
    LINES=$(bodies "$SOCK_MAX" true) || exit 0
    [ -n "$LINES" ] && printf '%s\n' "$LINES" | nc -U -w 2 "$SOCK" > /dev/null 2>&1
    exit 0
fi

BODIES=$(bodies "$OSC_MAX" false) || exit 0

SEQS=""
while IFS= read -r body; do
    [ -n "$body" ] && SEQS+=$(printf '\033]777;notify;haunt://cli-agent;%s\007' "$body")
done <<< "$BODIES"
[ -n "$SEQS" ] || exit 0

# Codex feeds hook stdout to the model on some events, so the fallback only ever writes to the terminal.
{ printf '%s' "$SEQS" > "$TTY"; } 2>/dev/null
exit 0
